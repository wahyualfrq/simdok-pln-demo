# =====================================================================
# SIMDOK — VERSI DEMO — Environment Variables untuk Vercel
# =====================================================================
# File ini HANYA contoh (tanpa secret). Isi nilai di:
#   Vercel Dashboard → Project → Settings → Environment Variables
# (jangan menyimpan nilai asli di repo). Lihat rules/15_VERCEL_DEPLOYMENT.md §4.
#
# JANGAN mengisi variabel GOOGLE_* — versi demo tidak memakai Google sungguhan.

# --- Aplikasi ---------------------------------------------------------
APP_NAME=SIMDOK
APP_ENV=production
APP_DEBUG=false
# WAJIB diisi dengan key BARU (jangan pakai key aplikasi asli). Buat di lokal:
#   php artisan key:generate --show
# lalu tempel hasilnya (berawalan "base64:") sebagai nilai APP_KEY di dashboard Vercel.
APP_KEY=
# URL deployment Vercel (https), mis. https://simdok-pln-demo.vercel.app
APP_URL=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# --- Mode demo --------------------------------------------------------
DEMO_MODE=true
# Akun demo bersifat PUBLIK (sudah ada di database/demo.sqlite). Harus sama dengan data di DB.
DEMO_USERNAME=demo
DEMO_PASSWORD=demo12345

# --- Log, session, cache, queue ---------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Cookie session: stateless sehingga login stabil walau fungsi berpindah instance.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
# File (di /tmp), BUKAN array: status manual folder disimpan lewat Cache dan harus bertahan antar-request.
CACHE_STORE=file
# Tanpa worker: queue dipaksa sync (mode demo juga memaksa ini di kode).
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Database ---------------------------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE, LARAVEL_STORAGE_PATH, dan VIEW_COMPILED_PATH diatur otomatis oleh api/index.php
# (diarahkan ke /tmp, karena filesystem Vercel read-only). Tidak perlu diisi di dashboard.

# --- Opsional (tidak dipakai saat runtime demo; database sudah berisi akun & data dummy) ---
# ADMIN_NAME="Pengguna Demo"
# ADMIN_USERNAME=demo
# ADMIN_EMAIL=demo.user@example.com
# ADMIN_PASSWORD=demo12345
